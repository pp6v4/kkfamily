generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberStatus {
  PENDING
  ACTIVE
  DISABLED
  LEFT
}

enum PermissionLevel {
  VIEW
  EDIT
  MANAGE
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum TripStatus {
  PLANNING
  PENDING
  DEPARTING
  COMPLETED
  CANCELLED
}

enum RecipeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MealStatus {
  DRAFT
  CONFIRMED
  COOKING
  COMPLETED
  CANCELLED
}

enum ShoppingItemStatus {
  WISHLIST
  NEXT_TRIP
  REPLENISH
  PURCHASED
}

enum InventoryTransactionType {
  STOCK_IN
  CONSUME
  ADJUST
  EXPIRE
}

enum IngredientKind {
  FOOD
  SEASONING
}

enum StockAvailability {
  PRESENT
  ABSENT
  UNKNOWN
}

enum CalendarEventType {
  ANNIVERSARY
  MEAL
  TRIP
  TASK
}

enum PackingItemStatus {
  PENDING
  PACKED
}

model User {
  id        String   @id @default(cuid())
  openId    String   @unique
  nickname  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  members   Membership[]
  trips     Trip[]
  recipeCategories RecipeCategory[]
  recipes Recipe[]
  ingredients Ingredient[]
  inventoryItems InventoryItem[]
  meals Meal[]
  shoppingLists ShoppingList[]
  calendarEvents CalendarEvent[]
  packingTemplates PackingTemplate[]
  invitations HouseholdInvitation[]
  auditLogs AuditLog[]
}

model CalendarEvent {
  id          String            @id @default(cuid())
  householdId String
  type        CalendarEventType
  title       String
  startsAt    DateTime
  endsAt      DateTime?
  sourceType  String?
  sourceId    String?
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  @@index([householdId, startsAt])
  @@index([householdId, sourceType, sourceId])
}

model Membership {
  id          String       @id @default(cuid())
  householdId String
  userId      String
  status      MemberStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  household   Household    @relation(fields: [householdId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  roles       MemberRole[]
  permissions ModulePermission[]
  tripMembers TripMember[]
  createdPackingTemplates PackingTemplate[] @relation("PackingTemplateCreator")
  responsiblePackingItems TripPackingItem[] @relation("PackingItemResponsible")
  version Int @default(1)
  permissionVersion Int @default(1)
  invitationRedemptions InvitationRedemption[]
  @@unique([householdId, userId])
}

model Role {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  memberRoles MemberRole[]
}

model MemberRole {
  membershipId String
  roleId       String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([membershipId, roleId])
}

model ModulePermission {
  id           String          @id @default(cuid())
  membershipId String
  module       String
  level        PermissionLevel
  effect       PermissionEffect @default(ALLOW)
  membership   Membership      @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  @@unique([membershipId, module])
}

model Trip {
  id          String     @id @default(cuid())
  householdId String
  title       String
  status      TripStatus @default(PLANNING)
  startsAt    DateTime
  endsAt      DateTime?
  destination String?
  createdAt   DateTime   @default(now())
  household   Household  @relation(fields: [householdId], references: [id])
  members     TripMember[]
  packingItems TripPackingItem[]
}

model HouseholdInvitation {
  id String @id @default(cuid())
  householdId String
  codeHash String @unique
  roleCodes String[]
  grants Json
  expiresAt DateTime
  maxUses Int @default(1)
  usedCount Int @default(0)
  revokedAt DateTime?
  version Int @default(1)
  createdById String
  createdAt DateTime @default(now())
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  redemptions InvitationRedemption[]
  @@index([householdId, createdAt])
}

model InvitationRedemption {
  invitationId String
  userId String
  membershipId String
  redeemedAt DateTime @default(now())
  invitation HouseholdInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id])
  @@id([invitationId, userId])
}

model AuditLog {
  id String @id @default(cuid())
  householdId String
  actorMembershipId String
  action String
  targetId String
  details Json
  createdAt DateTime @default(now())
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  @@index([householdId, createdAt])
}

model TripMember {
  tripId       String
  membershipId String
  canEdit      Boolean @default(false)
  joinedAt     DateTime @default(now())
  trip         Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  @@id([tripId, membershipId])
}

model PackingTemplate {
  id          String   @id @default(cuid())
  householdId String
  name        String
  description String?
  createdById String
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy   Membership @relation("PackingTemplateCreator", fields: [createdById], references: [id])
  items       PackingTemplateItem[]
  tripPackingItems TripPackingItem[]
  @@unique([householdId, name])
  @@index([householdId, archived])
}

model PackingTemplateItem {
  id              String   @id @default(cuid())
  templateId      String
  name            String
  defaultQuantity Decimal? @db.Decimal(12, 3)
  unit            String?
  note            String?
  sortOrder       Int      @default(0)
  template        PackingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tripPackingItems TripPackingItem[]
  @@index([templateId, sortOrder])
}

model TripPackingItem {
  id                      String            @id @default(cuid())
  tripId                  String
  sourceTemplateId        String?
  sourceTemplateItemId    String?
  name                    String
  quantity                Decimal?          @db.Decimal(12, 3)
  unit                    String?
  note                    String?
  status                  PackingItemStatus @default(PENDING)
  responsibleMembershipId String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  trip                    Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sourceTemplate          PackingTemplate? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  sourceTemplateItem      PackingTemplateItem? @relation(fields: [sourceTemplateItemId], references: [id], onDelete: SetNull)
  responsibleMembership   Membership? @relation("PackingItemResponsible", fields: [responsibleMembershipId], references: [id], onDelete: SetNull)
  @@unique([tripId, sourceTemplateItemId])
  @@index([tripId, status])
  @@index([responsibleMembershipId])
}

model RecipeCategory {
  id          String    @id @default(cuid())
  householdId String
  name        String
  sortOrder   Int       @default(0)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipes     Recipe[]
  @@unique([householdId, name])
  @@index([householdId, sortOrder])
}

model Ingredient {
  id          String    @id @default(cuid())
  householdId String
  name        String
  defaultUnit String
  kind        IngredientKind @default(FOOD)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipeItems RecipeIngredient[]
  inventoryItems InventoryItem[]
  seasonings RecipeSeasoning[]
  @@unique([householdId, name, kind])
}

model Recipe {
  id          String       @id @default(cuid())
  householdId String
  categoryId  String?
  name        String
  status      RecipeStatus @default(DRAFT)
  version     Int          @default(1)
  coverObjectKey String?
  steps       Json
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category    RecipeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ingredients RecipeIngredient[]
  seasonings  RecipeSeasoning[]
  mealItems   MealItem[]
  @@index([householdId, status, categoryId])
}

model RecipeIngredient {
  recipeId     String
  ingredientId String
  quantity     Decimal? @db.Decimal(12, 3)
  unit         String
  optional     Boolean  @default(false)
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  @@id([recipeId, ingredientId])
}

model RecipeSeasoning {
  id       String @id @default(cuid())
  recipeId String
  name     String
  ingredientId String?
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id])
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  @@unique([recipeId, name])
}

model InventoryItem {
  id           String @id @default(cuid())
  householdId  String
  ingredientId String
  quantity     Decimal? @db.Decimal(12, 3)
  availability StockAvailability @default(UNKNOWN)
  version      Int @default(1)
  unit         String
  expiresAt    DateTime?
  location     String?
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  transactions InventoryTransaction[]
  @@index([householdId, expiresAt])
}

model InventoryTransaction {
  id            String @id @default(cuid())
  inventoryItemId String
  type          InventoryTransactionType
  quantityDelta Decimal? @db.Decimal(12, 3)
  reason        String?
  actorMembershipId String?
  sourceType    String?
  sourceId      String?
  sourceVersion Int?
  beforeQuantity Decimal? @db.Decimal(12, 3)
  afterQuantity Decimal? @db.Decimal(12, 3)
  beforeAvailability StockAvailability?
  afterAvailability StockAvailability?
  createdAt     DateTime @default(now())
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  @@index([inventoryItemId, createdAt])
  @@unique([inventoryItemId, sourceType, sourceId, sourceVersion], map: "InventoryTransaction_source_key")
}

model Meal {
  id          String @id @default(cuid())
  householdId String
  scheduledAt DateTime
  mealType    String
  localDate   String
  slotKey     String @default("")
  version     Int @default(1)
  snapshotVersion Int @default(0)
  completedAt DateTime?
  completedFromVersion Int?
  status      MealStatus @default(DRAFT)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items       MealItem[]
  dishes      MealDish[]
  snapshots   MealSnapshot[]
  @@unique([householdId, localDate, mealType, slotKey])
  @@index([householdId, scheduledAt])
}

model MealDish {
  mealId String
  recipeId String
  cookMultiplier Decimal @default(1) @db.Decimal(8, 3)
  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  @@id([mealId, recipeId])
}

model MealSnapshot {
  id String @id @default(cuid())
  mealId String
  version Int
  createdById String
  createdAt DateTime @default(now())
  data Json
  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  @@unique([mealId, version])
}

model MealItem {
  id          String @id @default(cuid())
  mealId      String
  recipeId    String
  addedById   String
  note        String?
  meal        Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  recipe      Recipe @relation(fields: [recipeId], references: [id])
  @@unique([mealId, recipeId, addedById])
}

model ShoppingList {
  id          String @id @default(cuid())
  householdId String
  name        String
  systemKey   String?
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items       ShoppingItem[]
  @@index([householdId])
  @@unique([householdId, systemKey])
}

model ShoppingItem {
  id          String @id @default(cuid())
  listId      String
  name        String
  quantity    Decimal? @db.Decimal(12, 3)
  unit        String?
  status      ShoppingItemStatus @default(NEXT_TRIP)
  sourceType  String
  sourceId    String?
  sourceVersion Int?
  sourceItemKey String?
  previousItemId String?
  version Int @default(1)
  purchasedAt DateTime?
  purchasedById String?
  list        ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  @@index([listId, status])
  @@unique([listId, sourceType, sourceId, sourceVersion, sourceItemKey], map: "ShoppingItem_source_key")
}
