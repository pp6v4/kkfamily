generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberStatus {
  PENDING
  ACTIVE
  DISABLED
  LEFT
}

enum PermissionLevel {
  VIEW
  EDIT
  MANAGE
}

enum TripStatus {
  PLANNING
  PENDING
  DEPARTING
  COMPLETED
  CANCELLED
}

enum RecipeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MealStatus {
  DRAFT
  CONFIRMED
  COOKING
  COMPLETED
  CANCELLED
}

enum ShoppingItemStatus {
  WISHLIST
  NEXT_TRIP
  REPLENISH
  PURCHASED
}

enum InventoryTransactionType {
  STOCK_IN
  CONSUME
  ADJUST
  EXPIRE
}

enum CalendarEventType {
  ANNIVERSARY
  MEAL
  TRIP
  TASK
}

model User {
  id        String   @id @default(cuid())
  openId    String   @unique
  nickname  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  members   Membership[]
  trips     Trip[]
  recipeCategories RecipeCategory[]
  recipes Recipe[]
  ingredients Ingredient[]
  inventoryItems InventoryItem[]
  meals Meal[]
  shoppingLists ShoppingList[]
  calendarEvents CalendarEvent[]
}

model CalendarEvent {
  id          String            @id @default(cuid())
  householdId String
  type        CalendarEventType
  title       String
  startsAt    DateTime
  endsAt      DateTime?
  sourceType  String?
  sourceId    String?
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  @@index([householdId, startsAt])
  @@index([householdId, sourceType, sourceId])
}

model Membership {
  id          String       @id @default(cuid())
  householdId String
  userId      String
  status      MemberStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  household   Household    @relation(fields: [householdId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  roles       MemberRole[]
  permissions ModulePermission[]
  tripMembers TripMember[]
  @@unique([householdId, userId])
}

model Role {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  memberRoles MemberRole[]
}

model MemberRole {
  membershipId String
  roleId       String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([membershipId, roleId])
}

model ModulePermission {
  id           String          @id @default(cuid())
  membershipId String
  module       String
  level        PermissionLevel
  membership   Membership      @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  @@unique([membershipId, module])
}

model Trip {
  id          String     @id @default(cuid())
  householdId String
  title       String
  status      TripStatus @default(PLANNING)
  startsAt    DateTime
  endsAt      DateTime?
  destination String?
  createdAt   DateTime   @default(now())
  household   Household  @relation(fields: [householdId], references: [id])
  members     TripMember[]
}

model TripMember {
  tripId       String
  membershipId String
  canEdit      Boolean @default(false)
  joinedAt     DateTime @default(now())
  trip         Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  @@id([tripId, membershipId])
}

model RecipeCategory {
  id          String    @id @default(cuid())
  householdId String
  name        String
  sortOrder   Int       @default(0)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipes     Recipe[]
  @@unique([householdId, name])
  @@index([householdId, sortOrder])
}

model Ingredient {
  id          String    @id @default(cuid())
  householdId String
  name        String
  defaultUnit String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipeItems RecipeIngredient[]
  inventoryItems InventoryItem[]
  @@unique([householdId, name])
}

model Recipe {
  id          String       @id @default(cuid())
  householdId String
  categoryId  String?
  name        String
  status      RecipeStatus @default(DRAFT)
  coverObjectKey String?
  steps       Json
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category    RecipeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ingredients RecipeIngredient[]
  seasonings  RecipeSeasoning[]
  mealItems   MealItem[]
  @@index([householdId, status, categoryId])
}

model RecipeIngredient {
  recipeId     String
  ingredientId String
  quantity     Decimal? @db.Decimal(12, 3)
  unit         String
  optional     Boolean  @default(false)
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  @@id([recipeId, ingredientId])
}

model RecipeSeasoning {
  id       String @id @default(cuid())
  recipeId String
  name     String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  @@unique([recipeId, name])
}

model InventoryItem {
  id           String @id @default(cuid())
  householdId  String
  ingredientId String
  quantity     Decimal @db.Decimal(12, 3)
  unit         String
  expiresAt    DateTime?
  location     String?
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  transactions InventoryTransaction[]
  @@index([householdId, expiresAt])
}

model InventoryTransaction {
  id            String @id @default(cuid())
  inventoryItemId String
  type          InventoryTransactionType
  quantityDelta Decimal @db.Decimal(12, 3)
  reason        String?
  createdAt     DateTime @default(now())
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  @@index([inventoryItemId, createdAt])
}

model Meal {
  id          String @id @default(cuid())
  householdId String
  scheduledAt DateTime
  mealType    String
  status      MealStatus @default(DRAFT)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items       MealItem[]
  @@index([householdId, scheduledAt])
}

model MealItem {
  id          String @id @default(cuid())
  mealId      String
  recipeId    String
  addedById   String
  note        String?
  meal        Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  recipe      Recipe @relation(fields: [recipeId], references: [id])
  @@unique([mealId, recipeId, addedById])
}

model ShoppingList {
  id          String @id @default(cuid())
  householdId String
  name        String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items       ShoppingItem[]
  @@index([householdId])
}

model ShoppingItem {
  id          String @id @default(cuid())
  listId      String
  name        String
  quantity    Decimal? @db.Decimal(12, 3)
  unit        String?
  status      ShoppingItemStatus @default(NEXT_TRIP)
  sourceType  String
  sourceId    String?
  list        ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  @@index([listId, status])
}
